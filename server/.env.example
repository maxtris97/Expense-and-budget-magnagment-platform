PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/finflow
JWT_SECRET=finflow_super_secret_jwt_key_2026_production_style
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
COOKIE_SECRET=finflow_cookie_signing_secret_98765

# SMS Notification Provider (Options: mock, fast2sms, twilio)
SMS_PROVIDER=mock
SMS_API_KEY=
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Email Service Provider (Options: mock, smtp)
EMAIL_PROVIDER=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@finflow.io
