PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/finflow?retryWrites=true&w=majority
JWT_SECRET=finflow_super_secret_jwt_key_2026_production_style
JWT_EXPIRES_IN=7d
CLIENT_URL=https://fineflow-finance.onrender.com
COOKIE_SECRET=finflow_cookie_signing_secret_98765

# ============================================================
# EMAIL PROVIDER CONFIGURATION (Choose ONE of the options below)
# ============================================================

# OPTION A: Google Gmail SMTP (Easiest - Free 500 emails/day)
# Note: Generate a 16-character App Password at:
# Google Account -> Security -> 2-Step Verification -> App Passwords
EMAIL_SERVICE=gmail
EMAIL_USER=youraccount@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx
EMAIL_FROM=FineFlow Finance <youraccount@gmail.com>

# OPTION B: Resend REST API (Recommended for Render to prevent SMTP port blocks)
# Free 100 emails/day at https://resend.com
# RESEND_API_KEY=re_123456789abcdef
# RESEND_FROM=FineFlow Finance <onboarding@resend.dev>

# OPTION C: Custom SMTP (Brevo / SendGrid / Mailgun / AWS SES)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_login
# SMTP_PASS=your_smtp_key

# ============================================================
# SMS NOTIFICATION PROVIDER (Choose ONE of the options below)
# ============================================================

# OPTION A: Fast2SMS (India Mobile Numbers - Quick & Inexpensive)
# Register at https://www.fast2sms.com
FAST2SMS_API_KEY=your_fast2sms_api_key_here
FAST2SMS_ROUTE=otp

# OPTION B: Twilio (Global SMS)
# Register at https://www.twilio.com
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+1234567890

# OPTION C: MSG91 (India / Global)
# Register at https://msg91.com
# MSG91_AUTH_KEY=your_msg91_auth_key
# MSG91_TEMPLATE_ID=your_template_id
